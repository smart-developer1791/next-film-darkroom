{
  "name": "next-film-darkroom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:social": "node scripts/export-social-card.mjs",
    "preview:images": "node scripts/capture-previews.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "6.0.2",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "prettier": "3.9.10"
  },
  "type": "module",
  "license": "MIT",
  "description": "Softlight Lab: a Next.js photo darkroom with a private Web Worker preview, reproducible colour recipes and server-generated recipe cards.",
  "engines": {
    "node": ">=24.11.0 <25"
  }
